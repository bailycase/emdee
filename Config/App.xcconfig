// Identity follows Shepherd: com.bailycase.<app> ships, Debug is .dev (no updater, its own
// preferences and sandbox container), and the iPhone and iPad app is .ios.
PRODUCT_NAME = emdee
PRODUCT_BUNDLE_IDENTIFIER = com.bailycase.emdee
PRODUCT_BUNDLE_IDENTIFIER[config=Debug][sdk=macosx*] = com.bailycase.emdee.dev
PRODUCT_BUNDLE_IDENTIFIER[sdk=iphone*] = com.bailycase.emdee.ios
INFOPLIST_KEY_CFBundleDisplayName = emdee
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
DEVELOPMENT_TEAM = 4J6D7M7D79
CODE_SIGN_STYLE = Automatic

SWIFT_VERSION = 6.0
SUPPORTED_PLATFORMS = iphoneos iphonesimulator macosx
SDKROOT = auto
ALWAYS_SEARCH_USER_PATHS = NO
IPHONEOS_DEPLOYMENT_TARGET = 26.0
MACOSX_DEPLOYMENT_TARGET = 26.0
TARGETED_DEVICE_FAMILY = 1,2

// Apple silicon only on the Mac, as Shepherd: Sparkle's prebuilt helpers are thinned in CI.
ARCHS[sdk=macosx*] = arm64

GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = Config/Info.plist
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.productivity
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight UIInterfaceOrientationPortraitUpsideDown
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor

// Mac hardening, as Shepherd: hardened runtime plus Enhanced Security, on the Mac only (at
// project level it would push arm64e onto iOS). Pointer authentication stays off because
// Sparkle ships no arm64e slice.
CODE_SIGN_ENTITLEMENTS[sdk=macosx*] = Config/emdee.entitlements
ENABLE_HARDENED_RUNTIME = YES
ENABLE_ENHANCED_SECURITY[sdk=macosx*] = YES
ENABLE_POINTER_AUTHENTICATION = NO

// Where dyld finds embedded frameworks (Sparkle on the Mac).
LD_RUNPATH_SEARCH_PATHS[sdk=macosx*] = $(inherited) @executable_path/../Frameworks
LD_RUNPATH_SEARCH_PATHS[sdk=iphone*] = $(inherited) @executable_path/Frameworks
